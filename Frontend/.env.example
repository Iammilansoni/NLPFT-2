# =============================================================================
# NLPForge Frontend - Environment Configuration Template
# =============================================================================
# Copy this file to .env and update values as needed
# IMPORTANT: Only NEXT_PUBLIC_* variables are exposed to the browser
# =============================================================================

# =============================================================================
# API CONNECTION (REQUIRED)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# APPLICATION BRANDING
# =============================================================================
NEXT_PUBLIC_APP_NAME=NLPForge
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# PUBLIC DEMO (recruiter-facing deployments only — leave unset otherwise)
# =============================================================================
# Set to "true" only on a deployment seeded via Backend/scripts/seed_demo.py.
# Shows a dismissible banner site-wide and a one-click "demo login" button on
# the login page. Anything other than exactly "true" (including unset) keeps
# both features off, which is what every non-demo deployment should use.
NEXT_PUBLIC_DEMO_MODE=false
# Only needed if the backend was seeded with non-default SEED_DEMO_EMAIL /
# SEED_DEMO_PASSWORD (see Backend/scripts/seed_demo.py) — otherwise the
# frontend already defaults to that script's own defaults.
# NEXT_PUBLIC_DEMO_EMAIL=demo@nlpforge.dev
# NEXT_PUBLIC_DEMO_PASSWORD=DemoForge!2026
