# NPM Security Configuration
# Prevent malicious package installation and script execution

# Disable script execution for all packages
ignore-scripts=true

# Disable package funding messages
fund=false

# Disable automatic audit reporting
audit-level=moderate

# Require package integrity verification
package-lock-only=true

# Disable legacy peer deps warnings (but still required for Next.js ecosystem)
legacy-peer-deps=true

# Use npm CI for production builds (reproducible builds)
prefer-offline=true
prefer-locked=true

# Disable deprecated package warnings
disallow-deprecated=false

# Use strict SSL verification
strict-ssl=true

# Disable automatic npm update checks
update-notifier=false
