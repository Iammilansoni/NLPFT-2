# Gemini API (REQUIRED for dataset generation)
GEMINI_API_KEY=AIzaSyDFJ9ewPfNYPRKjrdqeT1f_CCgZK-qeMx8

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nlpforge
POSTGRES_PASSWORD=nlpforge_secure_password
POSTGRES_DB=nlpforge
DATABASE_URL=postgresql+asyncpg://nlpforge:nlpforge_secure_password@postgres:5432/nlpforge

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=nlpforge_redis_secure_password_2024
REDIS_URL=redis://:nlpforge_redis_secure_password_2024@redis:6379/0
INDEX_NAME=idx:api

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=production
SECRET_KEY=BRRUDdEDLR1zU5Oc9ycxLNVLdM7skVnfZTaDkwqg7ZA
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Ollama Configuration (for embeddings)
# -----------------------------------------------------------------------------
# For Docker, Ollama runs on host machine
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NODE_ENV=production

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
