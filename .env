# Environment variables for Docker Compose

# HuggingFace Token (optional, for LLM service)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Redis Configuration (for Dataset Generator)
REDIS_URL=redis://redis:6379/0

# MongoDB Configuration (for NLP Testing features)
MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=nlpforge

# Backend Configuration
ENVIRONMENT=production

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://nlpforge:nlpforge_secure_password@localhost:5432/nlpforge

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=production
