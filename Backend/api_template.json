{
  "version": 1,
  "defaults": {
    "qa_model": "deepset/minilm-uncased-squad2",
    "qa_threshold": 0.2
  },
  "apis": [
    {
      "name": "login",
      "endpoint_template": "<base_url>/api/login",
      "intent_keywords": [
        "login",
        "sign in",
        "log in",
        "credentials",
        "validate",
        "authenticate"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?",
            "What is the site or URL?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "username",
          "questions": [
            "What is the username?",
            "What is the first credential (the user name)?"
          ],
          "default": "user123"
        },
        {
          "key": "password",
          "questions": [
            "What is the password?",
            "What is the second credential (the password)?"
          ],
          "default": "pass123"
        }
      ]
    },
    {
      "name": "logout",
      "endpoint_template": "<base_url>/api/logout",
      "intent_keywords": [
        "logout",
        "log out",
        "sign out"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "token",
          "questions": [
            "What is the token?",
            "What is the authentication token or bearer token?"
          ],
          "default": "session_token"
        }
      ]
    },
    {
      "name": "register",
      "endpoint_template": "<base_url>/api/register",
      "intent_keywords": [
        "register",
        "sign up",
        "create account"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "username",
          "questions": [
            "What is the username?"
          ],
          "default": "new_user"
        },
        {
          "key": "email",
          "questions": [
            "What is the email address?",
            "Which email is provided?"
          ],
          "default": "user@example.com"
        },
        {
          "key": "password",
          "questions": [
            "What is the password?"
          ],
          "default": "StrongPass@123"
        }
      ]
    },
    {
      "name": "reset_password",
      "endpoint_template": "<base_url>/api/reset_password",
      "intent_keywords": [
        "reset",
        "forgot password",
        "recover",
        "reset password"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "email",
          "questions": [
            "What is the email address?",
            "Which account's email is mentioned?"
          ],
          "default": "user@example.com"
        }
      ]
    },
    {
      "name": "update_profile",
      "endpoint_template": "<base_url>/api/update_profile",
      "intent_keywords": [
        "update profile",
        "edit profile",
        "change name",
        "change phone"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "user_id",
          "questions": [
            "What is the user id?"
          ],
          "default": "U12345"
        },
        {
          "key": "name",
          "questions": [
            "What is the user's name?"
          ],
          "default": "Milan Soni"
        },
        {
          "key": "phone",
          "questions": [
            "What is the phone number?"
          ],
          "default": "+91-9999999999"
        }
      ]
    },
    {
      "name": "upload_file",
      "endpoint_template": "<base_url>/api/upload_file",
      "intent_keywords": [
        "upload",
        "upload file",
        "send file",
        "attach file"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "file_name",
          "questions": [
            "What is the file name?"
          ],
          "default": "report.pdf"
        },
        {
          "key": "file_type",
          "questions": [
            "What is the file type or extension?"
          ],
          "default": "pdf"
        }
      ]
    },
    {
      "name": "download_file",
      "endpoint_template": "<base_url>/api/download_file",
      "intent_keywords": [
        "download file",
        "download",
        "get file",
        "fetch file"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "file_id",
          "questions": [
            "What is the file id?"
          ],
          "default": "F98765"
        }
      ]
    },
    {
      "name": "search",
      "endpoint_template": "<base_url>/api/search",
      "intent_keywords": [
        "search",
        "find",
        "lookup"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "query",
          "questions": [
            "What is the search query?",
            "What should be searched?"
          ],
          "default": "project report"
        },
        {
          "key": "filters",
          "literal": [
            "date",
            "type"
          ]
        }
      ]
    },
    {
      "name": "get_user",
      "endpoint_template": "<base_url>/api/get_user",
      "intent_keywords": [
        "get user details",
        "fetch user",
        "retrieve user",
        "get user",
        "user details",
        "fetch user info",
        "get account",
        "fetch account"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "user_id",
          "questions": [
            "What is the user id?"
          ],
          "default": "U12345"
        }
      ]
    },
    {
      "name": "delete_account",
      "endpoint_template": "<base_url>/api/delete_account",
      "intent_keywords": [
        "delete account",
        "remove account",
        "close account"
      ],
      "slots": [
        {
          "key": "base_url",
          "questions": [
            "Which website or domain is mentioned?"
          ],
          "required": true,
          "postprocess": "base_url"
        },
        {
          "key": "user_id",
          "questions": [
            "What is the user id?"
          ],
          "default": "U12345"
        },
        {
          "key": "confirm",
          "questions": [
            "Is the deletion confirmed?"
          ],
          "default": true
        }
      ]
    }
  ]
}