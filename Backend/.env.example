# =============================================================================
# NLPForge Backend - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env files with real credentials!
# =============================================================================

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
# Primary data storage for users, templates, datasets, audit logs
DATABASE_URL=postgresql+asyncpg://nlpforge:your_db_password_here@localhost:5432/nlpforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nlpforge
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=nlpforge

# =============================================================================
# REDIS (Vector Database)
# =============================================================================
# Redis Stack with RediSearch for vector similarity search
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# =============================================================================
# ADMIN UI CREDENTIALS (Development Only)
# =============================================================================
# Redis Commander (http://localhost:8081)
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=your_redis_commander_password_here

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# JWT Secret Key (REQUIRED - minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_minimum_32_characters_long

# API Key Encryption Key (REQUIRED for storing LLM provider API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY_ENCRYPTION=your_fernet_key_here

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# EMAIL / SMTP CONFIGURATION (REQUIRED for password reset & verification)
# =============================================================================
# For Gmail: Use App Password (not your regular password)
# Create App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=NLPForge

# =============================================================================
# AI / ML CONFIGURATION
# =============================================================================
# Google Gemini API (REQUIRED for dataset generation)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Configuration (for embeddings)
# Install Ollama: https://ollama.ai
# Start server: ollama serve
# Pull models: ollama pull nomic-embed-text
OLLAMA_HOST=http://localhost:11434
