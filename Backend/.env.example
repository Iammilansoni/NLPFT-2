# =============================================================================
# NLPForge backend — for running the API on the HOST (not in Docker)
# =============================================================================
# Pairs with docker-compose.dev.yml (Postgres + Redis in Docker, Ollama on the
# host). For the all-in-Docker stack use the repo-root .env.example instead.
#   cp Backend/.env.example Backend/.env
# =============================================================================

DATABASE_URL=postgresql+asyncpg://nlpforge:nlpforge_dev@localhost:5432/nlpforge
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nlpforge_dev
OLLAMA_HOST=http://localhost:11434

EXECUTION_MODE=local            # local = Ollama embeddings; cloud = in-process ONNX
EXTRACTION_MODEL=llama3.2:3b
ENVIRONMENT=development
LOG_LEVEL=INFO

# JWT signing key (>= 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-dev-only-change-me-0000
# Fernet key for stored LLM-provider API keys:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY_ENCRYPTION=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional
GEMINI_API_KEY=
# Deployment-wide provider keys. Optional: users can save their own keys in
# Settings -> AI Providers. A key here also lists that provider's models in the
# shared model catalogue.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Every provider in Backend/app/llm/provider_registry.py reads its own variable
# (MISTRAL_API_KEY, OPENAI_API_KEY, NVIDIA_API_KEY, JINA_API_KEY, ...).

# Default embedding model for users who haven't picked one (Settings ->
# Embedding model). Any provider/model works; defaults follow EXECUTION_MODE:
# local -> ollama/nomic-embed-text, cloud -> builtin/BAAI/bge-small-en-v1.5.
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=

# Request-body extraction runs rules first, then a model only for what's left.
# The model is the user's own default connection if they saved one, else the
# local Ollama EXTRACTION_MODEL. No key is ever required.
# EXTRACTION_MODEL=llama3.2:3b
# EXTRACTION_USE_USER_LLM=true
# Dataset generation falls back to this Gemini model when GEMINI_API_KEY is set.
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Model catalogue (models are listed live from each provider, never hard-coded).
# MODEL_CATALOG_SYNC_MINUTES=360       # how often providers are re-listed
# MODEL_RETIRE_GRACE_HOURS=72          # missing this long -> retired
# MODEL_RETIRED_RETENTION_DAYS=7       # retired and unused this long -> deleted
# MODEL_CATALOG_PUBLIC_PROVIDERS=openrouter   # listings that need no key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
GOOGLE_CLIENT_ID=
# Local-only helpers that read OTP codes from the DB when SMTP is not set up.
ENABLE_DEV_ENDPOINTS=false
