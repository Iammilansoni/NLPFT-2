[
  {
    "query": "Create order for customer 12345",
    "api": "Create_Customer_Order",
    "endpoint": "/v1/orders",
    "method": "POST",
    "request": {
      "items": [
        {
          "quantity": 2,
          "product_id": "prod_ABC123"
        }
      ],
      "payment": {
        "method": "card",
        "card_token": "tok_test_4242"
      },
      "customer_id": "cust_987654",
      "shipping_address": {
        "city": "Jaipur",
        "line1": "12 Park Lane",
        "line2": null,
        "state": "RJ",
        "country": "IN",
        "postal_code": "302020"
      }
    },
    "expected_response": {
      "items": [
        {
          "price": 999,
          "quantity": 2,
          "product_id": "prod_ABC123"
        }
      ],
      "status": "created",
      "message": "Order created and payment authorized.",
      "currency": "INR",
      "order_id": "ord_20251129_0001",
      "total_amount": 1998,
      "estimated_delivery": "2025-12-04"
    },
    "scenario_type": "valid",
    "test_category": "valid_flow",
    "notes": "Realistic order creation"
  },
