# =============================================================================
# NLPForge — configuration for `docker compose up`
# =============================================================================
#   cp .env.example .env     then set the three REQUIRED values below.
# Everything else has a working default. Service hostnames (postgres, redis,
# ollama) are set by docker-compose.yml, not here.
# =============================================================================

# --- REQUIRED ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
# JWT signing key, >= 32 chars:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Recommended --------------------------------------------------------------
# Fernet key used to encrypt LLM-provider API keys stored in the database:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY_ENCRYPTION=

# --- Optional features --------------------------------------------------------
# Dataset generation (Settings -> LLM providers can also hold per-user keys).
GEMINI_API_KEY=
# Deployment-wide provider keys. Optional: users can save their own keys in
# Settings -> AI Providers. A key here also lists that provider's models in the
# shared model catalogue.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Every provider in Backend/app/llm/provider_registry.py reads its own variable
# (MISTRAL_API_KEY, OPENAI_API_KEY, NVIDIA_API_KEY, JINA_API_KEY, ...).

# Default embedding model for users who haven't picked one (Settings ->
# Embedding model). Any provider/model works; defaults follow EXECUTION_MODE:
# local -> ollama/nomic-embed-text, cloud -> builtin/BAAI/bge-small-en-v1.5.
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=

# Model catalogue (models are listed live from each provider, never hard-coded).
# MODEL_CATALOG_SYNC_MINUTES=360       # how often providers are re-listed
# MODEL_RETIRE_GRACE_HOURS=72          # missing this long -> retired
# MODEL_RETIRED_RETENTION_DAYS=7       # retired and unused this long -> deleted
# MODEL_CATALOG_PUBLIC_PROVIDERS=openrouter   # listings that need no key

# E-mail delivery for sign-up verification codes and password reset.
# Without it the app still runs; use the demo account or Google sign-in.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NLPForge

# Google sign-in (OAuth client ID, "Web application" type).
GOOGLE_CLIENT_ID=

# --- Tuning (defaults shown) --------------------------------------------------
# EXTRACTION_MODEL=llama3.2:3b     # Ollama model for request-body extraction
# DEMO_MODE=true                   # demo banner + one-click demo login
# SEED_DEMO=true                   # seed the 20-template demo tenant on boot
# RERANKER_ENABLED=false           # cross-encoder; measured worse, see evals/
# STAGE1_TOP_K=25
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
